{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*.{png,jpg,gif}", "/css/*"]
  },
  "routes": [
    {
      "route": "/home",
      "allowedRoles": ["anonymous"]
    }
  ],
    "responseOverrides": {
        "404": {
        "rewrite": "/index.html",
        "statusCode": 200
        }
    }
}
